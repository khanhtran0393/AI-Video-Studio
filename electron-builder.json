{
  "appId": "com.aivideostudio.independent",
  "productName": "AI Video Studio",
  "artifactName": "AI-Video-Studio-${version}-${arch}.${ext}",
  "portable": {
    "artifactName": "AI-Video-Studio-Portable-${version}-${arch}.${ext}"
  },
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "package.json",
    "nova/**/*",
    "auto-fix/redaction.js",
    "auto-fix/client-error-reporter/*.js",
    "!nova/**/*.map",
    "nova/editor-pro/nova-remotion/bundle/**/*.map",
    "!nova/node_modules{,/**/*}",
    "!nova/upscaler-bin{,/**/*}",
    "!nova/inpaint-bin{,/**/*}",
    "!nova/sqlite-bin{,/**/*}",
    "!nova/onnx-bin{,/**/*}",
    "!nova/ytdlp-bin{,/**/*}",
    "!nova/editor-pro/remotion-browser{,/**/*}",
    "!nova/voice-studio/.venv-omni{,/**/*}",
    "!nova/voice-studio/data{,/**/*}",
    "!nova/voice-backend/data{,/**/*}",
    "!nova/voice-backend/.venv-omni{,/**/*}",
    "!nova/tmp-asar-app{,/**/*}",
    "!nova/tmp-*",
    "!nova/.tmp-*",
    "!nova/**/tmp-*",
    "!nova/**/.tmp-*",
    "!nova/**/*.log",
    "!nova/**/__pycache__{,/**/*}",
    "!nova/**/*.pyc",
    "!nova/**/*.pyo",
    "!nova/editor-pro/nova-remotion/bundle/assets/*-a*_*"
  ],
  "asar": true,
  "asarUnpack": [
    "nova/**/*.py",
    "nova/voice-backend/**/*",
    "nova/editor-pro/nova-remotion/bundle/**/*",
    "node_modules/ffmpeg-static/**/*",
    "node_modules/ffprobe-static/**/*",
    "node_modules/onnxruntime-node/**/*",
    "node_modules/@remotion/compositor-win32-x64-msvc/**/*"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "artifactName": "AI-Video-Studio-Setup-${version}-${arch}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AI Video Studio",
    "uninstallDisplayName": "AI Video Studio"
  },
  "publish": null
}
