{
  "name": "ai-video-studio",
  "version": "1.0.1",
  "description": "AI Video Studio desktop application",
  "private": true,
  "main": "nova/main.plain.js",
  "author": "AI Video Studio",
  "productName": "AI Video Studio",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check:syntax": "node nova/scripts/syntax-check.js",
    "check:ipc": "node nova/scripts/ipc-inventory.js",
    "check:shared": "node nova/scripts/shared-names-check.js",
    "check:size": "node nova/scripts/size-budget-check.js",
    "check:toplevel": "node nova/scripts/toplevel-check.js",
    "check": "npm run check:syntax && npm run check:ipc && npm run check:exports && npm run check:shared && npm run check:shared-shadow && npm run check:shadow && npm run check:size && npm run check:toplevel && npm run check:docs && npm run check:selftest",
    "check:exports": "node nova/scripts/exports-contract-check.js",
    "check:docs": "node nova/scripts/docs-sync-check.js",
    "check:selftest": "node nova/scripts/checker-fixture-test.js",
    "scan:lifecycle": "node nova/scripts/lifecycle-log-scan.js",
    "check:all": "npm run check && npm run test:foundation && npm run test:video-agent && npm run test:voice && npm run test:auto-fix",
    "test:foundation": "node nova/scripts/foundation-test.js",
    "test:agent-bridge": "node nova/scripts/agent-bridge-test.js",
    "test:local-media": "node nova/scripts/local-media-test.js",
    "test:web-origin": "node nova/scripts/web-origin-qa.js",
    "test:video-agent": "node nova/video-agent/test.js && node nova/video-agent/test-ipc.js && node nova/video-agent/test-bridge.js && node nova/video-agent/test-phases.js && node nova/video-agent/test-behavior-frame.js && node nova/video-agent/test-ai-gateway.js",
    "test:video-agent:render": "electron nova/video-agent/test-render-real.js",
    "test:video-agent:live": "node nova/video-agent/test-ai-live.js",
    "test:auto-fix": "npm --prefix auto-fix run test:all",
    "test:voice": "node nova/scripts/voice-contract-test.js",
    "test:voice:integration": "node nova/scripts/voice-integration-test.js",
    "test:voice:all": "npm run test:voice && npm run test:voice:integration",
    "test:voice:live": "node nova/scripts/voice-live-test.js",
    "test:voice:ui": "node nova/scripts/voice-ui-smoke.js",
    "build:win": "electron-builder --config electron-builder.json --win",
    "build": "electron-builder --config electron-builder.json",
    "smoke:packaged": "node nova/scripts/packaged-smoke.js",
    "build:smoke": "npm run build:win && npm run smoke:packaged",
    "check:shadow": "node nova/scripts/handler-shadow-check.js",
    "check:bundle": "node nova/scripts/bundle-selfcheck.js",
    "test:maintenance": "node nova/core/test-maintenance.js",
    "check:shared-shadow": "node nova/scripts/shared-shadow-check.js"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "@remotion/transitions": "4.0.518",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "^1.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.518",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.6.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.2"
  }
}
