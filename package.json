{
  "name": "ai-video-studio",
  "version": "1.0.1",
  "description": "AI Video Studio desktop application",
  "private": true,
  "main": "nova/main.plain.js",
  "author": "AI Video Studio",
  "productName": "AI Video Studio",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check:syntax": "node nova/scripts/syntax-check.js",
    "check:ipc": "node nova/scripts/ipc-inventory.js",
    "check:parity": "node nova/scripts/parity-check.js",
    "test:foundation": "node nova/scripts/foundation-test.js",
    "test:video-agent": "node nova/video-agent/test.js && node nova/video-agent/test-ipc.js && node nova/video-agent/test-bridge.js && node nova/video-agent/test-phases.js && node nova/video-agent/test-behavior-frame.js && node nova/video-agent/test-ai-gateway.js",
    "test:video-agent:render": "electron nova/video-agent/test-render-real.js",
    "test:auto-fix": "npm --prefix auto-fix run test:all",
    "test:voice": "node nova/scripts/voice-contract-test.js",
    "test:voice:live": "node nova/scripts/voice-live-test.js",
    "build:win": "electron-builder --config electron-builder.json --win",
    "build": "electron-builder --config electron-builder.json",
    "smoke:packaged": "node nova/scripts/packaged-smoke.js",
    "build:smoke": "npm run build:win && npm run smoke:packaged"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "@remotion/transitions": "4.0.518",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "^1.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.518",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.2"
  }
}
